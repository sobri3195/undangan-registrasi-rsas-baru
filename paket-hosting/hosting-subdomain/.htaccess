Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# Private configuration for the single-folder hosting bundle.
RewriteRule ^private(?:/|$) - [F,L]
# Fixed destination: do not derive redirects from request Host headers.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://undanganregistrasirsas.puskesau.com%{REQUEST_URI} [R=301,L,NE]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
